---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="pagination-wrapper" aria-label="Paginacion">
      {page.url.prev ? (
        <a href={page.url.prev} class="arcade-btn arcade-btn-b" rel="prev">
          &#9664; Prev
        </a>
      ) : (
        <span class="arcade-btn arcade-btn-b is-disabled" aria-hidden="true">
          &#9664; Prev
        </span>
      )}

      <span class="pixel page-count">
        Stage {String(page.currentPage).padStart(2, "0")} /{" "}
        {String(page.lastPage).padStart(2, "0")}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="arcade-btn arcade-btn-b" rel="next">
          Next &#9654;
        </a>
      ) : (
        <span class="arcade-btn arcade-btn-b is-disabled" aria-hidden="true">
          Next &#9654;
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination-wrapper {
    @apply mx-auto mb-10 mt-auto flex max-w-3xl items-center justify-center gap-4 px-4 pt-8;
  }
  .page-count {
    @apply whitespace-nowrap text-[0.55rem] leading-none opacity-60;
  }
  .is-disabled {
    @apply pointer-events-none opacity-30;
  }
</style>
