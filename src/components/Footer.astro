---
import Socials from "./Socials.astro";
import { SOCIALS } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

// TODO: apuntar a /contacto cuando exista la página (ver docs/ROADMAP.md).
// Mientras tanto la ranura usa el mailto ya declarado en SOCIALS.
const contactHref =
  SOCIALS.find(social => social.name === "Mail" && social.active)?.href ??
  "/about/";
---

<footer class={noMarginTop ? "" : "mt-auto"}>
  <!-- ===== Ranura de monedas =====
       Es la CTA del sitio disfrazada de puerta de monedas: en un arcade,
       meter la moneda es el único paso que separa mirar de jugar. -->
  <div class="coin-door">
    <div class="coin-door-inner">
      <span class="coin-slot" aria-hidden="true"></span>
      <p class="coin-copy">
        <span class="pixel coin-title blink">Insert coin</span>
        <span class="coin-lede">
          ¿Tienes un proyecto en mente? Empecemos la partida.
        </span>
      </p>
      <a href={contactHref} class="arcade-btn arcade-btn-a coin-cta">
        Hablemos
      </a>
    </div>
  </div>

  <div class="footer-wrapper">
    <Socials centered />
    <p class="pixel copyright">
      <!-- El isotipo `[}` en naranja de marca. Va decorativo: el nombre
           ya está escrito al lado, así que repetirlo en el `alt` sólo
           duplicaría la lectura del lector de pantalla. -->
      <img
        class="copyright-mark"
        src="/assets/brand/isotipo-bracket.svg"
        alt=""
        aria-hidden="true"
        width="14"
        height="14"
      />
      <span>&copy; {currentYear} Codevs</span>
      <span class="opacity-40">&middot; 1 player</span>
    </p>
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }

  .coin-door {
    @apply border-t-2 border-skin-line bg-skin-card/40;
  }
  .coin-door-inner {
    @apply mx-auto flex max-w-3xl flex-col items-center gap-4 px-4 py-6 text-center sm:flex-row sm:text-left;
  }
  .coin-copy {
    @apply flex flex-1 flex-col items-center gap-1 sm:items-start;
  }
  .coin-title {
    @apply text-[0.65rem] leading-none text-skin-accent2;
  }
  .coin-lede {
    @apply text-sm opacity-70;
  }
  .coin-cta {
    @apply flex-none;
  }

  .footer-wrapper {
    @apply mx-auto flex max-w-3xl flex-col items-center justify-between gap-3 px-4 py-5 sm:flex-row-reverse;
  }
  .copyright {
    @apply flex flex-wrap items-center justify-center gap-2 text-[0.5rem] leading-loose opacity-70;
  }
  .copyright-mark {
    @apply h-3.5 w-auto;
  }
</style>
