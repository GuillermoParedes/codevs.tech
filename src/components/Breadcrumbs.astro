---
// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

/* Rótulos en español para los segmentos fijos de la URL: la ruta va en inglés
   pero la interfaz no. Van SIN tilde a propósito — la miga se compone en Press
   Start 2P y esa fuente no trae glifos acentuados (ver `.pixel` en base.css).
   Sólo afecta al texto: los `href` siguen usando el segmento crudo. */
const LABELS: Record<string, string> = {
  posts: "Articulos",
  tags: "Etiquetas",
  search: "Busqueda",
  about: "Sobre mi",
};

const label = (segment: string) => LABELS[segment] ?? segment;

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
breadcrumbList[0] === "posts" &&
  breadcrumbList.splice(
    0,
    2,
    `${LABELS.posts} (pagina ${breadcrumbList[1] || 1})`
  );

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
breadcrumbList[0] === "tags" &&
  !isNaN(Number(breadcrumbList[2])) &&
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${
      Number(breadcrumbList[2]) === 1
        ? ""
        : "(pagina " + breadcrumbList[2] + ")"
    }`
  );
---

<nav class="breadcrumb pixel" aria-label="breadcrumb">
  <ul>
    <li>
      <a href="/">Inicio</a>
      <span aria-hidden="true">&rsaquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class={`${index > 0 ? "lowercase" : "capitalize"}`}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {label(decodeURIComponent(breadcrumb))}
            </span>
          </li>
        ) : (
          <li>
            <a href={`/${breadcrumb}/`}>{label(breadcrumb)}</a>
            <span aria-hidden="true">&rsaquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  .breadcrumb {
    @apply mx-auto mb-2 mt-8 w-full max-w-3xl px-4 text-[0.5rem] leading-loose;
  }
  .breadcrumb ul li {
    @apply inline;
  }
  .breadcrumb ul li a {
    @apply opacity-50 hover:text-skin-accent hover:opacity-100;
  }
  .breadcrumb ul li span {
    @apply opacity-50;
  }
  .breadcrumb ul li span[aria-current="page"] {
    @apply text-skin-accent opacity-100;
  }
  .breadcrumb ul li:not(:last-child) a {
    @apply hover:opacity-100;
  }
</style>
