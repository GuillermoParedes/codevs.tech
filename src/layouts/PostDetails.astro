---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import SeriesNav from "@components/SeriesNav.astro";
import { getSeriesForPost } from "@utils/getSeries";
import {
  difficultyStars,
  formatLevel,
  getLevelMap,
  getLevelMeta,
} from "@utils/arcade";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await post.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

/* ========== Nivel ========== */

const levelMap = getLevelMap(posts);
const meta = getLevelMeta(post, levelMap);

/* La serie es navegación explícita entre artículos encadenados; convive con
   prev/next de nivel, que sigue siendo cronológico y global. */
const series = getSeriesForPost(post, posts);

/* ========== Datos estructurados ==========
   El índice de la serie (`seriesOrder === 1`) declara además un ItemList con
   las partes en orden: es la señal que le dice a Google que estas siete URLs
   son un cuerpo único y cuál de ellas es la portada. Sólo lo emite el índice
   para no repetir la misma lista siete veces. */
const postURL = new URL(`/posts/${post.slug}/`, SITE.website).href;

const seriesSchema =
  series && post.data.seriesOrder === 1
    ? [
        {
          "@type": "ItemList",
          "@id": `${postURL}#series`,
          name: series.name,
          numberOfItems: series.posts.length,
          itemListOrder: "https://schema.org/ItemListOrderAscending",
          itemListElement: series.posts.map((entry, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: entry.data.title,
            url: new URL(`/posts/${entry.slug}/`, SITE.website).href,
          })),
        },
      ]
    : [];

const breadcrumbs = [
  { name: "Inicio", url: new URL("/", SITE.website).href },
  { name: "Artículos", url: new URL("/posts/", SITE.website).href },
  { name: title, url: postURL },
];

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  headline: title,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
  pageType: "article" as const,
  tags,
  breadcrumbs,
  extraSchema: seriesSchema,
};

/* Anterior/siguiente van por número de nivel, no por fecha de modificación:
   si el HUD dice "LEVEL 03", "NEXT LEVEL" tiene que ser el 04. */
const chronological = [...posts].sort(
  (a, b) =>
    new Date(a.data.pubDatetime).getTime() -
    new Date(b.data.pubDatetime).getTime()
);
const currentIndex = chronological.findIndex(entry => entry.slug === post.slug);
const prevLevel = currentIndex > 0 ? chronological[currentIndex - 1] : null;
const nextLevel =
  currentIndex > -1 && currentIndex < chronological.length - 1
    ? chronological[currentIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />

  <!-- ===== HUD del nivel =====
       Se queda pegado arriba mientras se lee: es el marcador de la partida,
       y la barra de vida es el progreso de lectura. -->
  <div class="level-hud sticky-under-frame">
    <div class="mx-auto max-w-3xl px-4">
      <div class="hud !border-t-0">
        <a href="/posts/" class="exit-link">&#9664; Exit</a>
        <span>
          <span class="hud-label">Level</span>
          <span class="text-skin-accent">{meta.label}</span>
        </span>
        <span class="hidden sm:inline">
          <span class="hud-label">World</span>
          {meta.world}
        </span>
        <span
          class="text-skin-accent2"
          title={`Dificultad ${meta.difficulty} de 5`}
        >
          {difficultyStars(meta.difficulty)}
        </span>
        <span class="ml-auto">
          <span class="hud-label">Time</span>
          {meta.minutes} min
        </span>
      </div>
      <div class="life-bar border-t-0" aria-hidden="true">
        <div class="life-bar-fill" id="level-bar-fill"></div>
      </div>
    </div>
  </div>

  <main id="main-content">
    <p class="pixel stage-tag">
      Stage {meta.label} &mdash; {meta.world}
    </p>

    <h1 transition:name={slugifyStr(title)} class="post-title">{title}</h1>
    <Datetime
      pubDatetime={pubDatetime}
      modDatetime={modDatetime}
      size="lg"
      className="my-3"
    />

    <article id="article" class="prose mx-auto mt-8 max-w-3xl">
      <Content />
    </article>

    <!-- ===== Serie ===== -->
    {series && <SeriesNav series={series} currentSlug={post.slug} />}

    <!-- ===== Power-ups (etiquetas) ===== -->
    <section class="power-ups" aria-label="Etiquetas">
      <h2 class="pixel power-ups-title">Power-ups</h2>
      <ul>
        {
          tags.map(tag => (
            <li>
              <a href={`/tags/${slugifyStr(tag)}/`} class="power-up">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ===== Fin de nivel ===== -->
    <section class="arcade-panel level-complete" aria-label="Fin del articulo">
      <p class="pixel level-complete-title neon">Level complete</p>
      <p class="level-complete-lede">
        ¿Te sirvió? Compártelo y sigue con el siguiente nivel.
      </p>
      <div class="level-complete-actions">
        <ShareLinks />
        <button id="back-to-top" class="arcade-btn arcade-btn-b" type="button">
          &#9650; Volver arriba
        </button>
      </div>
    </section>

    <!-- ===== Navegación entre niveles ===== -->
    <nav class="level-nav" aria-label="Niveles adyacentes">
      {
        prevLevel && (
          <a href={`/posts/${prevLevel.slug}/`} class="level-nav-card">
            <span class="pixel level-nav-label">
              &#9664; Prev level{" "}
              {formatLevel(levelMap.get(prevLevel.slug) ?? 1)}
            </span>
            <span class="level-nav-title">{prevLevel.data.title}</span>
          </a>
        )
      }
      {
        nextLevel && (
          <a
            href={`/posts/${nextLevel.slug}/`}
            class="level-nav-card level-nav-next"
          >
            <span class="pixel level-nav-label">
              Next level {formatLevel(levelMap.get(nextLevel.slug) ?? 1)}{" "}
              &#9654;
            </span>
            <span class="level-nav-title">{nextLevel.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12 pt-8;
  }
  .post-title {
    @apply font-display text-3xl font-bold uppercase leading-[0.95] tracking-tight sm:text-4xl;
  }
  .stage-tag {
    @apply mb-3 text-[0.55rem] leading-none text-skin-accent opacity-80;
  }

  .level-hud {
    @apply z-30 border-b-2 border-skin-line bg-skin-fill;
  }
  .exit-link {
    @apply text-skin-base opacity-60 hover:text-skin-accent hover:opacity-100;
  }

  /* ===== Power-ups ===== */
  .power-ups {
    @apply mt-12 max-w-3xl px-0;
  }
  .power-ups-title {
    @apply mb-3 text-[0.55rem] leading-none opacity-50;
  }
  .power-ups ul {
    @apply flex flex-wrap gap-2;
  }
  .power-up {
    @apply inline-block border-2 border-skin-line px-3 py-1.5 text-xs uppercase tracking-widest transition-colors hover:border-skin-accent hover:text-skin-accent;
  }
  .power-up::before {
    content: "\002B";
    @apply mr-1.5 text-skin-accent2;
  }

  /* ===== Fin de nivel ===== */
  .level-complete {
    @apply mt-12 max-w-3xl px-6 py-6;
  }
  .level-complete-title {
    @apply text-sm leading-none;
  }
  .level-complete-lede {
    @apply mt-3 text-sm opacity-70;
  }
  .level-complete-actions {
    @apply mt-5 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between;
  }

  /* ===== Navegación entre niveles ===== */
  .level-nav {
    @apply mt-8 grid max-w-3xl grid-cols-1 gap-4 px-0 sm:grid-cols-2;
  }
  .level-nav-card {
    @apply flex flex-col gap-2 border-2 border-skin-line p-4 transition-colors hover:border-skin-accent;
  }
  .level-nav-next {
    @apply text-right sm:col-start-2;
  }
  .level-nav-label {
    @apply text-[0.55rem] leading-none text-skin-accent;
  }
  .level-nav-title {
    @apply text-sm opacity-80;
  }
</style>

<script is:inline data-astro-rerun>
  /** Barra de vida = progreso de lectura. El elemento ya existe en el HUD,
   *  aquí sólo se le mueve el ancho. */
  function updateScrollProgress() {
    const bar = document.getElementById("level-bar-fill");
    if (!bar) return;

    const paint = () => {
      const scrolled =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      bar.style.width = height > 0 ? (scrolled / height) * 100 + "%" : "0%";
    };

    paint();
    document.addEventListener("scroll", paint, { passive: true });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      )
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ml-2 opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Envuelve cada bloque de código en una "ventana" con barra de título,
   * etiqueta de lenguaje y botón de copiar. */
  function attachCodeChrome() {
    const copyButtonLabel = "copiar";
    const codeBlocks = Array.from(document.querySelectorAll("#article pre"));

    for (const codeBlock of codeBlocks) {
      // El script se re-ejecuta en cada view transition: no envolver dos veces.
      if (codeBlock.parentElement?.classList.contains("code-window")) continue;

      const language = codeBlock.getAttribute("data-language") || "code";

      const window_ = document.createElement("div");
      window_.className = "code-window";

      const bar = document.createElement("div");
      bar.className = "code-bar";

      const dots = document.createElement("span");
      dots.className = "code-dots";
      dots.setAttribute("aria-hidden", "true");
      dots.innerHTML = "<i></i><i></i><i></i>";

      const label = document.createElement("span");
      label.className = "code-lang";
      label.textContent = language;

      const copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.className = "copy-code";
      copyButton.textContent = copyButtonLabel;

      bar.append(dots, label, copyButton);

      codeBlock.setAttribute("tabindex", "0");
      codeBlock.parentNode?.insertBefore(window_, codeBlock);
      window_.append(bar, codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.textContent = "copiado";

      setTimeout(() => {
        button.textContent = copyButtonLabel;
      }, 700);
    }
  }
  attachCodeChrome();

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
