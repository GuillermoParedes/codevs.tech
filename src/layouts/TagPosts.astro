---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import ArcadeSelector from "@components/ArcadeSelector";
import { getLevelMap, toSelectorItem } from "@utils/arcade";
import { SITE } from "@config";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
  tag: string;
  tagName: string;
}

const { page, tag, tagName } = Astro.props;

// Igual que en Posts: la numeración sale de la colección completa.
const levelMap = getLevelMap(await getCollection("blog"));
const items = page.data.map(post => toSelectorItem(post, levelMap));
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header activeNav="tags" />
  <Main
    eyebrow="World"
    pageTitle={["Mundo: ", `${tagName}`]}
    titleTransition={tag}
    pageDesc={`Todos los niveles del mundo "${tagName}".`}
  >
    <ArcadeSelector client:visible items={items} heading={`World ${tagName}`} />
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
