---
import Breadcrumbs from "@components/Breadcrumbs.astro";

interface BaseProps {
  pageDesc?: string;
  /** Rótulo pequeño en píxeles encima del título: "World select", "Stage 03"… */
  eyebrow?: string;
}

interface StringTitleProp extends BaseProps {
  pageTitle: string;
}

interface ArrayTitleProp extends BaseProps {
  pageTitle: [string, string];
  titleTransition: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<Breadcrumbs />
<main id="main-content">
  {props.eyebrow && <p class="pixel screen-eyebrow">{props.eyebrow}</p>}
  {
    "titleTransition" in props ? (
      <h1>
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1>{props.pageTitle}</h1>
    )
  }
  {props.pageDesc && <p class="screen-desc">{props.pageDesc}</p>}
  <slot />
</main>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-4;
  }
  .screen-eyebrow {
    @apply mb-2 text-[0.55rem] leading-none text-skin-accent;
  }
  #main-content h1 {
    @apply font-display text-3xl font-bold uppercase leading-[0.95] tracking-tight sm:text-4xl;
  }
  .screen-desc {
    @apply mb-6 mt-3 text-sm opacity-70;
  }
</style>
