---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import ArcadeSelector from "@components/ArcadeSelector";
import { getLevelMap, toSelectorItem } from "@utils/arcade";
import { SITE } from "@config";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;

// El mapa de niveles se calcula sobre la colección COMPLETA, no sobre la
// página: si no, el nivel 01 cambiaría en cada página del paginado.
const levelMap = getLevelMap(await getCollection("blog"));
const items = page.data.map(post => toSelectorItem(post, levelMap));
---

<Layout title={`Articulos | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    eyebrow={`Stage select · pagina ${page.currentPage} de ${page.lastPage}`}
    pageTitle="All levels"
    pageDesc="Todos los articulos publicados. Mueve la palanca para elegir."
  >
    <ArcadeSelector client:visible items={items} heading="Select your level" />
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
