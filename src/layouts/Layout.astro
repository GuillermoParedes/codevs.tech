---
import { LOCALE, SITE, SOCIALS } from "@config";
import "@styles/base.css";
import { ViewTransitions } from "astro:transitions";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /* Título limpio, sin el sufijo del sitio. `<title>` lleva "… | Codevs"
     porque ayuda en la SERP, pero `headline` y las tarjetas sociales quieren
     el título a secas. Por defecto cae a `title`. */
  headline?: string;
  /* `article` sólo en páginas de artículo. Cualquier otra página (home,
     listados, /search, /404) es `website`: emitir BlogPosting en todas ellas
     es schema inválido y Google descarta el bloque entero. */
  pageType?: "article" | "website";
  /* Palabras clave / temas del artículo — alimentan `keywords` y
     `articleSection` del Article. */
  tags?: string[];
  /* Migas ya resueltas por la página: [{ name, url }] de raíz a hoja. */
  breadcrumbs?: { name: string; url: string }[];
  /* Nodos JSON-LD extra que aporta la página (ItemList de una serie,
     FAQPage, etc.). Se añaden al @graph. */
  extraSchema?: Record<string, unknown>[];
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  headline = title,
  pageType = "website",
  tags = [],
  breadcrumbs = [],
  extraSchema = [],
} = Astro.props;

const socialImageURL = new URL(
  ogImage ?? SITE.ogImage ?? "og.png",
  Astro.url.origin
).href;

/* Identidades estables del sitio. Los `@id` con fragmento son lo que permite
   a Google unir Person ↔ WebSite ↔ Article en una sola entidad en vez de
   tratarlos como tres cosas sueltas. */
const siteURL = new URL(SITE.website).href;
const personId = `${siteURL}#person`;
const siteId = `${siteURL}#website`;

const person = {
  "@type": "Person",
  "@id": personId,
  name: SITE.author,
  url: profile,
  jobTitle: "Ingeniero de software",
  knowsAbout: [
    "Desarrollo frontend",
    "Claude Code",
    "Inteligencia artificial aplicada al desarrollo",
    "React",
    "Next.js",
    "Angular",
    "TypeScript",
    "Docker",
  ],
  sameAs: SOCIALS.filter(s => s.active && !s.href.startsWith("mailto:")).map(
    s => s.href
  ),
  logo: {
    "@type": "ImageObject",
    url: new URL("/assets/logo.png", siteURL).href,
  },
};

const website = {
  "@type": "WebSite",
  "@id": siteId,
  url: siteURL,
  name: SITE.title,
  description: SITE.desc,
  inLanguage: LOCALE.langTag?.[0] ?? "es-ES",
  publisher: { "@id": personId },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteURL}search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const article =
  pageType === "article" && pubDatetime
    ? {
        "@type": "BlogPosting",
        "@id": `${canonicalURL}#article`,
        headline,
        name: headline,
        description,
        image: socialImageURL,
        inLanguage: LOCALE.langTag?.[0] ?? "es-ES",
        datePublished: pubDatetime.toISOString(),
        dateModified: (modDatetime ?? pubDatetime).toISOString(),
        author: { "@id": personId },
        publisher: { "@id": personId },
        isPartOf: { "@id": siteId },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
        ...(tags.length && {
          keywords: tags.join(", "),
          articleSection: tags[0],
        }),
      }
    : null;

const breadcrumbList = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    }
  : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [person, website, article, breadcrumbList, ...extraSchema].filter(
    Boolean
  ),
};
---

<!doctype html>
<html
  lang=`${LOCALE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- El SVG es el isotipo `[}` en naranja de marca: es lo único del logo
         que sigue siendo legible a 16px. El .ico queda de respaldo para los
         navegadores que aún no leen favicons vectoriales. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta
      property="og:locale"
      content={(LOCALE.langTag?.[0] ?? "es-ES").replace("-", "_")}
    />
    <meta property="og:title" content={headline} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={headline} />

    <!-- Article Published/Modified time -->
    {
      pageType === "article" &&
        tags.map(tag => <meta property="article:tag" content={tag} />)
    }
    {
      pageType === "article" && (
        <meta property="article:author" content={SITE.author} />
      )
    }
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={headline} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Las tres familias viajan en la MISMA petición: varias en un solo
         `css2?family=…&family=…` no cuestan un RTT extra.
         · IBM Plex Mono — cuerpo y código.
         · Quicksand 700 — display del manual de marca, sólo titulares.
         · Press Start 2P — chrome del gabinete (ver `.pixel` en base.css). -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Quicksand:wght@700&family=Press+Start+2P&display=swap"
      rel="preload"
      as="style"
      onload="this.onload=null; this.rel='stylesheet';"
      crossorigin
    />

    <!-- El color de barra es el del plástico del gabinete, no el de la
         pantalla: es lo que toca el borde del viewport. -->
    <meta
      name="theme-color"
      content="#cccccc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d0d0d"
      media="(prefers-color-scheme: dark)"
    />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <ViewTransitions />

    <script is:inline src="/toggle-theme.js" async></script>
  </head>
  <body>
    <!-- Marco del gabinete + vidrio del tubo. Un único elemento fijo, sin
         wrappers alrededor del contenido: ver la nota en base.css. -->
    <div class="crt-glass" aria-hidden="true"></div>
    <slot />
  </body>
</html>
