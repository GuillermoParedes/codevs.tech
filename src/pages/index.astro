---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Socials from "@components/Socials.astro";
import ArcadeSelector from "@components/ArcadeSelector";
import getSortedPosts from "@utils/getSortedPosts";
import { getLevelMap, toSelectorItem } from "@utils/arcade";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

const levelMap = getLevelMap(sortedPosts);
const recentItems = sortedPosts
  .slice(0, SITE.postPerIndex)
  .map(post => toSelectorItem(post, levelMap));

const socialCount = SOCIALS.filter(social => social.active).length;

// TODO: apuntar a /contacto cuando exista la página (ver docs/ROADMAP.md).
// Mientras tanto la CTA usa el mailto que ya está declarado en SOCIALS.
const contactHref =
  SOCIALS.find(social => social.name === "Mail" && social.active)?.href ??
  "/about/";
---

<Layout>
  <Header />
  <main id="main-content">
    <!-- ===== Attract mode ===== -->
    <section id="hero">
      <p class="pixel attract" aria-hidden="true">
        <span class="text-skin-accent2">Player 1</span>
        <span class="blink">Ready</span>
      </p>

      <h1 class="display">
        Construyo<br />software<br /><span class="text-skin-accent"
          >que vende.</span
        >
      </h1>

      <div class="hero-rule" aria-hidden="true"></div>

      <div class="hero-actions">
        <a class="arcade-btn arcade-btn-a" href={contactHref}>
          &#9654; Hablemos
        </a>
        <a class="arcade-btn arcade-btn-b" href="/posts/">Ver niveles</a>
        <a
          target="_blank"
          href="/rss.xml"
          class="rss-link"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
            ><path
              d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
            ></path><path
              d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
            ></path><circle cx="6" cy="18" r="2"></circle>
          </svg>
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="hero-lede">
        Bienvenidos a mi espacio donde exploramos el apasionante mundo de la
        ingeniería de software. Aquí encontrarás artículos y tutoriales sobre
        JavaScript, Angular, Node.js, TypeScript, y NestJS, además de análisis
        sobre plataformas en la nube como Digital Ocean y mucho más. Compartiré
        soluciones, mejores prácticas y novedades tecnológicas para
        desarrolladores, abarcando desde el backend hasta el frontend. Ya sea
        que estés comenzando o buscando optimizar tus habilidades, este blog es
        el lugar para crecer juntos en el desarrollo de software moderno.
      </p>
      <p class="hero-cv">
        Puedes descargar mi CV realizando <a
          href="/cv-guillermo_paredes_torrez.pdf"
          target="_blank"
          rel="noopener">click acá</a
        >, si estás interesado en algún proyecto juntos.
      </p>

      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Redes sociales:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- ===== Pantalla de selección ===== -->
    {
      recentItems.length > 0 && (
        <section id="select-game">
          <h2 class="section-title">Select your game</h2>
          <ArcadeSelector
            client:visible
            items={recentItems}
            heading="Ultimos niveles"
            secHeading={false}
          />
          <div class="all-levels">
            <a href="/posts/" class="arcade-btn arcade-btn-b">
              Todos los niveles &#9654;
            </a>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Attract mode ===== */
  #hero {
    @apply pb-8 pt-10 sm:pt-14;
  }
  .attract {
    @apply mb-6 flex items-center gap-3 text-[0.6rem] leading-none;
  }
  #hero h1 {
    @apply text-[2.75rem] sm:text-7xl;
  }
  .hero-rule {
    @apply my-7 h-1 w-24 bg-skin-accent;
  }
  .hero-actions {
    @apply flex flex-wrap items-center gap-3;
  }
  #hero .rss-link {
    @apply ml-1 inline-flex items-center;
  }
  #hero .rss-icon {
    @apply h-6 w-6 scale-110 fill-skin-accent;
  }
  .hero-lede {
    @apply mt-8 max-w-2xl opacity-80;
  }
  .hero-cv {
    @apply mt-3 text-sm opacity-70;
  }
  .hero-cv a {
    @apply text-skin-accent underline decoration-dashed underline-offset-4;
  }
  .social-wrapper {
    @apply mt-6 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap opacity-70 sm:mb-0;
  }

  /* ===== Selección de nivel ===== */
  #select-game {
    @apply border-t-2 border-skin-line pb-6 pt-10;
  }
  .section-title {
    @apply mb-6 font-display text-xl font-bold uppercase tracking-tight sm:text-2xl;
  }
  .all-levels {
    @apply mt-8 text-center;
  }
</style>
